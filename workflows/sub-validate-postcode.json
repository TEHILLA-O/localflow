        -200,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst item = $input.first().json;\nconst district = item.postcode_district || item.postcode?.split(' ')[0];\nconst primary = ['NN1','NN2','NN3','NN4','NN5'];\nconst extended = ['NN6','NN7','NN8','NN9','NN10','NN11','NN12'];\nlet postcode_check = 'OUTSIDE';\nif (primary.includes(district)) postcode_check = 'PRIMARY';\nelse if (extended.includes(district)) postcode_check = 'EXTENDED';\nreturn [{ json: { ...item, postcode_check, postcode_district: district, api_fallback_used: true } }];\n"
      },
      "id": "ca50508b-e73d-4447-8334-55c72fbf888f",
      "name": "Normalise Postcode Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

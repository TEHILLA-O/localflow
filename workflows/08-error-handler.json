{
  "id": "d3a56caa-0404-4c11-9fe8-0f87e5855b50",
  "name": "WF-08 Error Handler",
  "nodes": [
    {
      "parameters": {
        "content": "WF-08 Central Error Handler",
        "width": 300,
        "height": 120
      },
      "id": "7d1c8b4b-a98c-4593-a9d9-8a46a609d028",
      "name": "WF-08 Central Error Handler",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        100
      ]
    },
    {
      "parameters": {},
      "id": "f905935c-e073-4b97-b35e-755d88e2b341",
      "name": "On Workflow Error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst err = $input.first().json;\nconst msg = (err.error?.message || err.message || '').toLowerCase();\nlet error_type = 'UNKNOWN';\nlet retryable = false;\nif (msg.includes('timeout') || msg.includes('econnreset')) { error_type = 'TRANSIENT_NETWORK'; retryable = true; }\nelse if (msg.includes('500') || msg.includes('502')) { error_type = 'EXTERNAL_API'; retryable = true; }\nelse if (msg.includes('validation') || msg.includes('invalid')) { error_type = 'VALIDATION'; }\nelse if (msg.includes('postgres') || msg.includes('database')) { error_type = 'DATABASE'; }\nelse if (msg.includes('auth')) { error_type = 'AUTHENTICATION'; }\nreturn [{ json: { ...err, error_type, retryable, retry_count: err.retry_count || 0 } }];\n"
      },
      "id": "788a9806-5f86-4049-b5fd-ab16bf283ce2",
      "name": "Classify Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_errors (workflow_name, workflow_execution_id, node_name, error_type, error_message, retryable, retry_count, entity_reference, status)\nVALUES ('{{ $json.workflow?.name || \"unknown\" }}', '{{ $json.execution?.id || \"\" }}', '{{ $json.error?.node?.name || \"\" }}',\n  '{{ $json.error_type }}', '{{ ($json.error?.message || \"\").replace(/'/g, \"''\") }}', {{ $json.retryable }}, {{ $json.retry_count }},\n  '{{ $json.entity_reference || \"\" }}', CASE WHEN {{ $json.retryable }} AND {{ $json.retry_count }} < 3 THEN 'RETRYING'::error_status ELSE 'MANUAL_ACTION_REQUIRED'::error_status END)\nRETURNING *;",
        "options": {}
      },
      "id": "d3df3d34-7e23-4eeb-8bdf-82dbcc995a47",
      "name": "Record Workflow Failure",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        600,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "LOCALFLOW_POSTGRES",
          "name": "LocalFlow PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "5bf46c94-1e82-4b4a-ad6a-ecd496553270",
              "leftValue": "={{ $json.status === 'MANUAL_ACTION_REQUIRED' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "4452ebfb-89f3-42d1-895d-207cc423a60a",
      "name": "Needs Owner Alert?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "fromEmail": "office@northamptonhomeservices.demo",
        "toEmail": "owner@northamptonhomeservices.demo",
        "subject": "LocalFlow Workflow Failure",
        "emailFormat": "text",
        "text": "={{ 'Workflow failure recorded.\\nWorkflow: ' + ($json.workflow_name || '') + '\\nError: ' + ($json.error_message || '') + '\\nStatus: ' + $json.status }}",
        "options": {}
      },
      "id": "e14e551c-75f9-4858-85bf-777147c7db36",
      "name": "Send Error Alert To Owner",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1200,
        200
      ],
      "credentials": {
        "smtp": {
          "id": "LOCALFLOW_MAILPIT",
          "name": "LocalFlow Mailpit SMTP"
        }
      }
    }
  ],
  "connections": {
    "On Workflow Error": {
      "main": [
        [
          {
            "node": "Classify Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Classify Error": {
      "main": [
        [
          {
            "node": "Record Workflow Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record Workflow Failure": {
      "main": [
        [
          {
            "node": "Needs Owner Alert?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs Owner Alert?": {
      "main": [
        [
          {
            "node": "Send Error Alert To Owner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },

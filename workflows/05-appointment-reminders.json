{
  "id": "0eb53c74-1a52-40e8-a34d-1588233c3ab2",
  "name": "WF-05 Appointment Reminders",
  "nodes": [
    {
      "parameters": {
        "content": "WF-05 Appointment Reminders\nIdempotent 24h and 2h reminders",
        "width": 300,
        "height": 120
      },
      "id": "ae8f2dad-525a-4a15-a2cd-ae9707ef71df",
      "name": "WF-05 Appointment Reminders",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        100
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      },
      "id": "1c9216d3-deec-4cc1-adc3-5db0007e5173",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT b.*, c.email, c.first_name FROM bookings b\nJOIN customers c ON c.id = b.customer_id\nWHERE b.status IN ('BOOKED','CONFIRMED')\n  AND b.reminder_24h_sent_at IS NULL\n  AND b.start_at <= NOW() + INTERVAL '24 hours'\n  AND b.start_at > NOW() + INTERVAL '23 hours';",
        "options": {}
      },
      "id": "82c0a4dc-189f-4b64-b539-558ac41eced3",
      "name": "Find Bookings Needing 24h Reminder",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        300,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "LOCALFLOW_POSTGRES",
          "name": "LocalFlow PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "office@northamptonhomeservices.demo",
        "toEmail": "={{ $json.recipient || $json.email }}",
        "subject": "={{ 'Reminder: appointment tomorrow \u2014 ' + $json.booking_reference }}",
        "emailFormat": "text",
        "text": "={{ 'Dear ' + $json.first_name + ',\\n\\nReminder: your appointment (' + $json.booking_reference + ') is in approximately 24 hours on ' + $json.start_at + '.\\n\\nNorthampton Home Services Ltd' }}",
        "options": {}
      },
      "id": "4f1067a7-3605-4a81-aa70-cc9341a82728",
      "name": "Send 24h Reminder",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        600,
        100
      ],
      "credentials": {
        "smtp": {
          "id": "LOCALFLOW_MAILPIT",
          "name": "LocalFlow Mailpit SMTP"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE bookings SET reminder_24h_sent_at = NOW(), updated_at = NOW()\nWHERE id = {{ $json.id }} AND reminder_24h_sent_at IS NULL RETURNING id;",
        "options": {}
      },
      "id": "0ff3439b-18c2-4dcf-af62-eec0f0ef8fea",
      "name": "Mark 24h Reminder Sent",
      "type": "n8n-nodes-base.postgres",

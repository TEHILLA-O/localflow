          "name": "LocalFlow PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT b.*, c.email, c.first_name FROM bookings b\nJOIN customers c ON c.id = b.customer_id\nWHERE b.status IN ('BOOKED','CONFIRMED')\n  AND b.reminder_2h_sent_at IS NULL\n  AND b.start_at <= NOW() + INTERVAL '2 hours'\n  AND b.start_at > NOW();",
        "options": {}
      },
      "id": "cb0f3348-f313-4aa2-9aaf-688507334eb6",

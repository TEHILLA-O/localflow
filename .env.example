# Timezone
GENERIC_TIMEZONE=Europe/London
TZ=Europe/London

# Mailpit (local SMTP)
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Business configuration
COMPANY_NAME=Northampton Home Services Ltd
COMPANY_EMAIL=office@northamptonhomeservices.demo
OWNER_ALERT_EMAIL=owner@northamptonhomeservices.demo
REVIEW_URL=https://example.com/reviews/northampton-home-services

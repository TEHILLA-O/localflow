# PostgreSQL
POSTGRES_DB=localflow
POSTGRES_USER=localflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# n8n
N8N_ENCRYPTION_KEY=CHANGE_ME_GENERATE_32_CHAR_KEY
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
